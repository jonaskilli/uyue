<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root_view"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".ui.book.source.AiBookSourceActivity">

    <io.legado.app.ui.widget.TitleBar
        android:id="@+id/title_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:contentInsetStartWithNavigation="0dp"
        app:displayHomeAsUp="true"
        app:title="AI 生成书源" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="10dp">

            <io.legado.app.ui.widget.text.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="小说网站地址（首页 / 搜索页 / 书籍详情页）">

                <io.legado.app.lib.theme.view.ThemeEditText
                    android:id="@+id/et_url"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textUri"
                    android:maxLines="3"
                    tools:ignore="SpeakableTextPresentCheck,TouchTargetSizeCheck" />
            </io.legado.app.ui.widget.text.TextInputLayout>

            <io.legado.app.ui.widget.text.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:hint="测试关键词（用来抓搜索结果页，可留空）">

                <io.legado.app.lib.theme.view.ThemeEditText
                    android:id="@+id/et_keyword"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="剑"
                    tools:ignore="SpeakableTextPresentCheck,TouchTargetSizeCheck" />
            </io.legado.app.ui.widget.text.TextInputLayout>

            <io.legado.app.ui.widget.text.AccentBgTextView
                android:id="@+id/btn_generate"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:text="开始生成" />

            <TextView
                android:id="@+id/tv_progress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:textColor="@color/secondaryText"
                android:textSize="13sp"
                tools:text="等待开始…" />

            <io.legado.app.ui.widget.text.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:hint="生成的书源（JSON）">

                <io.legado.app.lib.theme.view.ThemeEditText
                    android:id="@+id/et_result"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:enabled="false"
                    android:gravity="top"
                    android:minLines="8"
                    android:textColor="@color/secondaryText"
                    android:textSize="12sp"
                    tools:ignore="SpeakableTextPresentCheck,TouchTargetSizeCheck" />
            </io.legado.app.ui.widget.text.TextInputLayout>

            <io.legado.app.ui.widget.text.AccentBgTextView
                android:id="@+id/btn_save"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="10dp"
                android:alpha="0.4"
                android:gravity="center"
                android:text="保存到书源列表" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:lineSpacingExtra="3dp"
                android:text="说明：\n1. 生成过程会自动抓取「首页 → 搜索页 → 详情页 → 目录页 → 正文页」，再把源码交给 AI 推断规则，通常需要几十秒；\n2. AI 接口沿用「角色档案设置」里的配置（本地混元太极网关）；\n3. 生成结果仅供参考，导入后建议在「书源管理」里做一次「校验书源」，失效的规则可手动微调；\n4. 需要 JS 渲染、验证码或登录才能看的站点，生成成功率会明显偏低。"
                android:textColor="@color/secondaryText"
                android:textSize="12sp" />

        </LinearLayout>
    </ScrollView>

</LinearLayout>
