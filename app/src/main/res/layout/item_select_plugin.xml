<?xml version="1.0" encoding="utf-8"?>
<!--
  "更换插件"选择弹窗里的单个插件条目。
  原来用系统 setItems()，每行只有一条纯文字，行与行之间是纯空白、没有底色也没有边界，
  插件一多就糊成一片分不清。这里改成和配置列表同一套卡片视觉（圆角+描边+阴影），
  每行独立成块，一眼能数清有几行、选中哪一个。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="8dp"
    android:layout_marginTop="3dp"
    android:layout_marginBottom="3dp"
    android:elevation="2dp"
    android:background="@drawable/bg_tts_config_card"
    android:orientation="vertical"
    android:paddingStart="12dp"
    android:paddingTop="10dp"
    android:paddingEnd="12dp"
    android:paddingBottom="10dp">

    <!-- 插件名：主信息，用较大加粗深色字 -->
    <TextView
        android:id="@+id/tv_pick_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="15sp"
        android:textStyle="bold"
        android:textColor="@color/primaryText"
        android:maxLines="2"
        android:ellipsize="end"
        tools:text="通义千问-精简版" />

    <!-- 作者 | 版本：次要信息，没有内容时整行隐藏，避免留一条空行 -->
    <TextView
        android:id="@+id/tv_pick_sub"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:textSize="11sp"
        android:textColor="@color/secondaryText"
        android:maxLines="1"
        android:ellipsize="end"
        tools:text="命無言 | 1.2.0" />

</LinearLayout>
