<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:minHeight="56dp"
    android:orientation="horizontal"
    android:paddingStart="42dp"
    android:paddingEnd="10dp"
    android:paddingTop="6dp"
    android:paddingBottom="6dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tv_fx_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:singleLine="true"
            android:textColor="@color/primaryText"
            android:textSize="14sp"
            tools:text="Big explosion" />

        <TextView
            android:id="@+id/tv_fx_desc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:singleLine="true"
            android:textColor="?android:attr/textColorSecondary"
            android:textSize="11sp"
            tools:text="爆炸 · 90 帧 · 单次" />
    </LinearLayout>

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/iv_fx_play"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:contentDescription="试播该特效"
        android:padding="8dp"
        android:src="@drawable/ic_play_24dp"
        app:tint="@color/primaryText" />

    <io.legado.app.lib.theme.view.ThemeSwitch
        android:id="@+id/swt_fx_enabled"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:contentDescription="启用该特效"
        tools:ignore="TouchTargetSizeCheck" />

</LinearLayout>
