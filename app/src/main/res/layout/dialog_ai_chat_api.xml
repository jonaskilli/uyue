<?xml version="1.0" encoding="utf-8"?>
<!--
  「与角色对话」接口设置弹窗。
  输入格式与「AI处理章节」完全一致：接口@@模型@@密钥（3 段一组，可多组自动轮换），
  解析复用 AiChapterFixService.parseApiConfigs，无需重复学习配置方式。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingHorizontal="18dp"
    android:paddingTop="6dp"
    android:paddingBottom="14dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingVertical="8dp"
        android:text="对话接口设置"
        android:textSize="17sp"
        android:textStyle="bold" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="接口地址@@模型名@@密钥（支持多组轮换，写法同 AI 处理章节）"
                android:textSize="12sp" />

            <EditText
                android:id="@+id/et_api"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_edit"
                android:gravity="top"
                android:hint="https://api.xxx.com/v1@@deepseek-chat@@sk-xxx"
                android:minLines="2"
                android:maxLines="4"
                android:inputType="textMultiLine"
                android:textSize="13sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="携带的历史对话条数（默认 20）"
                android:textSize="12sp" />

            <EditText
                android:id="@+id/et_context_limit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_edit"
                android:inputType="number"
                android:singleLine="true"
                android:textSize="13sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="回复完成后若角色已绑定发音人，将自动朗读（用顶部 🔊 开关控制）"
                android:textSize="12sp" />
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:gravity="end"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tv_cancel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingHorizontal="18dp"
            android:paddingVertical="10dp"
            android:text="取消"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tv_save"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:background="@drawable/bg_role_chat_send"
            android:paddingHorizontal="22dp"
            android:paddingVertical="10dp"
            android:text="保存"
            android:textColor="#FFFFFFFF"
            android:textSize="14sp" />
    </LinearLayout>
</LinearLayout>
