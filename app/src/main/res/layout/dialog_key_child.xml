<?xml version="1.0" encoding="utf-8"?>
<!-- 恢复密钥：子行（该密钥里的一个 API）。默认只显示模型名，域名以小字补充。
     整体套一层 SwipeRevealLayout：左划露出右侧「删除」，长按则交给列表做拖拽排序。 -->
<io.legado.app.ui.widget.SwipeRevealLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <!-- 左划后露出的右侧操作区 -->
    <LinearLayout
        android:id="@+id/swipe_reveal"
        android:layout_width="96dp"
        android:layout_height="match_parent"
        android:layout_gravity="end|center_vertical"
        android:gravity="center"
        android:background="@color/key_delete_bg">

        <Button
            android:id="@+id/btn_child_delete"
            style="?android:attr/buttonStyleSmall"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="0dp"
            android:minHeight="28dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="删除"
            android:textColor="@android:color/white"
            android:textSize="12sp"
            android:focusable="false" />

    </LinearLayout>

    <!-- 正常内容（盖在操作区之上，左划时整体左移露出删除） -->
    <LinearLayout
        android:id="@+id/swipe_content"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/background"
        android:paddingStart="38dp"
        android:paddingEnd="8dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <View
                android:id="@+id/view_child_dot"
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_key_dot" />

            <TextView
                android:id="@+id/tv_child_index"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:textSize="12sp"
                android:textColor="@color/secondaryText" />

            <TextView
                android:id="@+id/tv_child_model"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="middle"
                android:singleLine="true"
                android:textColor="@color/primaryText"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tv_child_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxWidth="150dp"
                android:singleLine="true"
                android:ellipsize="end"
                android:layout_marginEnd="6dp"
                android:textSize="12sp"
                android:textColor="@color/secondaryText" />

            <Button
                android:id="@+id/btn_child_test"
                style="?android:attr/buttonStyleSmall"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="0dp"
                android:minHeight="28dp"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:text="测试"
                android:textSize="11sp"
                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                android:includeFontPadding="false"
                android:focusable="false" />

            <Button
                android:id="@+id/btn_child_models"
                style="?android:attr/buttonStyleSmall"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:minWidth="0dp"
                android:minHeight="28dp"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:text="模型"
                android:textSize="11sp"
                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                android:includeFontPadding="false"
                android:focusable="false" />

        </LinearLayout>

        <TextView
            android:id="@+id/tv_child_host"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:singleLine="true"
            android:textSize="11sp"
            android:textColor="@color/secondaryText" />

    </LinearLayout>

</io.legado.app.ui.widget.SwipeRevealLayout>
