<?xml version="1.0" encoding="utf-8"?>
<!--
  「声音插件」Spinner 展开后的下拉列表行。
  原来用系统 simple_spinner_dropdown_item，每行就是一条纯文字，行与行之间没有任何底色和边界，
  插件一多就全糊成一片分不清。这里改成和配置列表、"更换插件"弹窗同一套卡片视觉，
  每行独立成块、行间留缝，一眼能数清有几个插件、当前选的是哪个。
  上下左右都留边距：Spinner 的下拉面板本身有圆角和内边距，卡片贴着边会显得被裁掉。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="8dp"
    android:layout_marginTop="3dp"
    android:layout_marginEnd="8dp"
    android:layout_marginBottom="3dp"
    android:elevation="2dp"
    android:background="@drawable/bg_tts_config_card"
    android:orientation="vertical"
    android:paddingStart="12dp"
    android:paddingTop="10dp"
    android:paddingEnd="12dp"
    android:paddingBottom="10dp">

    <TextView
        android:id="@+id/tv_spin_plugin_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="15sp"
        android:textStyle="bold"
        android:textColor="@color/primaryText"
        android:maxLines="2"
        android:ellipsize="end"
        tools:text="通义千问-精简版" />

    <TextView
        android:id="@+id/tv_spin_plugin_sub"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:textSize="11sp"
        android:textColor="@color/secondaryText"
        android:maxLines="1"
        android:ellipsize="end"
        android:visibility="gone"
        tools:text="命無言 | 1.2.0"
        tools:visibility="visible" />

</LinearLayout>
