<?xml version="1.0" encoding="utf-8"?>
<!--
  「与角色对话」galgame 式全屏界面（自上而下）：
  顶部工具条（退出/标题/语音开关/接口设置）→ 立绘区（大图，无图时首字占位）
  → 台词框（角色名 + AI 流式回复，右上角「历史」入口）→ 输入栏。
  固定深色 galgame 风格，不随日/夜主题切换，保证立绘与台词面板观感稳定。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_role_chat"
    android:orientation="vertical">

    <!-- 顶部工具条 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="14dp">

        <TextView
            android:id="@+id/tv_back"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingVertical="8dp"
            android:paddingEnd="14dp"
            android:text="‹ 退出"
            android:textColor="#CCFFFFFF"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/tv_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:gravity="center"
            android:singleLine="true"
            android:textColor="#E6FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_voice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingHorizontal="8dp"
            android:paddingVertical="8dp"
            android:text="🔊 开"
            android:textColor="#CCFFFFFF"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/tv_api"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingHorizontal="4dp"
            android:paddingVertical="8dp"
            android:text="⚙ 接口"
            android:textColor="#CCFFFFFF"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- 立绘区 -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <TextView
            android:id="@+id/tv_placeholder"
            android:layout_width="150dp"
            android:layout_height="150dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_role_chat_placeholder"
            android:gravity="center"
            android:textColor="#99FFFFFF"
            android:textSize="56sp" />

        <ImageView
            android:id="@+id/iv_portrait"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="bottom|center_horizontal"
            android:paddingHorizontal="18dp"
            android:paddingBottom="18dp"
            android:scaleType="fitCenter"
            android:visibility="gone"
            android:contentDescription="角色立绘" />
    </FrameLayout>

    <!-- 台词框 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="12dp"
        android:layout_marginBottom="8dp"
        android:background="@drawable/bg_role_chat_panel"
        android:orientation="vertical"
        android:paddingHorizontal="14dp"
        android:paddingVertical="10dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_role_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:singleLine="true"
                android:ellipsize="end"
                android:textColor="#FFFFD54F"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_history"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingHorizontal="6dp"
                android:paddingVertical="4dp"
                android:text="📜 历史"
                android:textColor="#99FFFFFF"
                android:textSize="12sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tv_dialogue"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:lineSpacingExtra="4dp"
            android:maxLines="6"
            android:scrollbars="vertical"
            android:textColor="#F2FFFFFF"
            android:textSize="16sp" />
    </LinearLayout>

    <!-- 输入栏 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="12dp"
        android:layout_marginBottom="14dp"
        android:gravity="bottom"
        android:orientation="horizontal">

        <EditText
            android:id="@+id/et_input"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/bg_role_chat_input"
            android:hint="说点什么…（发送后只有角色回应）"
            android:maxLines="3"
            android:paddingHorizontal="12dp"
            android:paddingVertical="10dp"
            android:textColor="#F2FFFFFF"
            android:textColorHint="#61FFFFFF"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/tv_send"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_role_chat_send"
            android:gravity="center"
            android:paddingHorizontal="18dp"
            android:paddingVertical="11dp"
            android:text="发送"
            android:textColor="#FFFFFFFF"
            android:textSize="15sp" />
    </LinearLayout>
</LinearLayout>
