<?xml version="1.0" encoding="utf-8"?>
<!-- 单段音效卡片：复用 TTS 配置列表的圆角 + 描边 + 阴影背景，让每段之间有明显间隔。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="8dp"
    android:layout_marginTop="4dp"
    android:layout_marginBottom="4dp"
    android:elevation="2dp"
    android:orientation="vertical"
    android:background="@drawable/bg_tts_config_card">

    <LinearLayout
        android:id="@+id/layout_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="10dp"
        android:paddingTop="8dp"
        android:paddingEnd="4dp"
        android:paddingBottom="8dp">

        <!-- 第一行：外显名字。非每组第一段会隐藏；AI 音效的倍率与播放按钮直接放在这行右边 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tv_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="外显名字"
                android:textColor="@color/primaryText"
                android:textSize="15sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/tv_gain_ai"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:minWidth="42dp"
                android:gravity="end"
                android:text="1.00"
                android:textColor="@color/primaryText"
                android:textSize="15sp"
                android:visibility="gone" />

            <ImageButton
                android:id="@+id/btn_play_ai"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="试听"
                android:padding="6dp"
                android:src="@drawable/ic_play_24dp"
                android:tint="@color/primaryText"
                android:visibility="gone" />

        </LinearLayout>

        <!-- 第二行：括号音效名，例如 (打雷音效)；AI 音效隐藏 -->
        <TextView
            android:id="@+id/tv_effect"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/primaryText"
            android:textSize="13sp"
            android:alpha="0.85"
            android:maxLines="1"
            android:ellipsize="end" />

        <!-- 第三行：拖动把手 + 段名 + KB + 删除 + 弹性空白 + 倍率 + 播放 -->
        <LinearLayout
            android:id="@+id/ll_segment"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/btn_drag_handle"
                android:layout_width="22dp"
                android:layout_height="36dp"
                android:gravity="center"
                android:text="⠿"
                android:textColor="@color/primaryText"
                android:textSize="16sp"
                android:alpha="0.7"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tv_segment"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="音效一"
                android:textColor="@color/primaryText"
                android:textSize="13sp"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/tv_size"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="15 KB"
                android:textColor="@color/primaryText"
                android:textSize="12sp"
                android:alpha="0.85"
                android:maxLines="1" />

            <TextView
                android:id="@+id/btn_delete_segment"
                android:layout_width="32dp"
                android:layout_height="36dp"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="删"
                android:textColor="@color/primaryText"
                android:textSize="14sp"
                android:visibility="gone" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/tv_gain"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:minWidth="42dp"
                android:gravity="end"
                android:text="1.00"
                android:textColor="@color/primaryText"
                android:textSize="15sp" />

            <ImageButton
                android:id="@+id/btn_play"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="试听"
                android:padding="6dp"
                android:src="@drawable/ic_play_24dp"
                android:tint="@color/primaryText" />

        </LinearLayout>

        <!-- 第四行：减号 + 滑块 + 加号 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/btn_minus"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="音量减 0.05"
                android:gravity="center"
                android:text="−"
                android:textColor="@color/primaryText"
                android:textSize="22sp" />

            <SeekBar
                android:id="@+id/seek_gain"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:max="1000" />

            <TextView
                android:id="@+id/btn_plus"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="音量加 0.05"
                android:gravity="center"
                android:text="+"
                android:textColor="@color/primaryText"
                android:textSize="22sp" />

        </LinearLayout>

        <TextView
            android:id="@+id/tv_error"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/primaryText"
            android:textSize="11sp"
            android:visibility="gone" />

    </LinearLayout>

</LinearLayout>
