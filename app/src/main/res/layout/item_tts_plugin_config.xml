<?xml version="1.0" encoding="utf-8"?>
<!--
  配置列表的单条卡片。
  卡片要"圆角 + 描边 + 阴影"三层叠在一起，才能在满屏列表里把每一条单独框出来；
  光靠一条横线、或只差一点底色是看不出边界的。
  描边(tts_config_card_stroke)负责"框"，elevation 阴影负责"浮起来"，
  底色(tts_config_card_bg)比列表区底色更亮，负责"这块是独立的"。
  根节点必须是普通 LinearLayout：MaterialCardView 构造函数强制要求 App 主题为
  Theme.MaterialComponents，而本项目用的是 Theme.AppCompat.DayNight.NoActionBar，
  用了会在 RecyclerView 布局时抛 IllegalArgumentException 直接崩溃。
  内层 layout_content 单独承担 padding：层级缩进只加在它身上，
  加在外层卡片上会把卡片本体和描边一起内缩、宽度变得不对称。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="8dp"
    android:layout_marginTop="4dp"
    android:layout_marginBottom="4dp"
    android:elevation="2dp"
    android:background="@drawable/bg_tts_config_card">

    <LinearLayout
        android:id="@+id/layout_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="10dp"
        android:paddingTop="8dp"
        android:paddingEnd="4dp"
        android:paddingBottom="8dp"
        android:gravity="center_vertical">

    <CheckBox
        android:id="@+id/cb_enabled"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:padding="0dp" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <!-- 第一行：名称(左) + 标签(右上) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tv_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/primaryText"
                android:maxLines="1"
                android:ellipsize="none"
                tools:text="度沁遥｜知性女声｜大模型多情感" />

            <TextView
                android:id="@+id/tv_tag"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingHorizontal="6dp"
                android:paddingVertical="2dp"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="@color/secondaryText"
                android:background="@drawable/bg_tag_outline"
                android:maxLines="1"
                android:ellipsize="none"
                tools:text="女中年02" />
        </LinearLayout>

        <!-- 第二行：声线 + 采样率 + 参数 -->
        <TextView
            android:id="@+id/tv_params"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textSize="11sp"
            android:textColor="@color/secondaryText"
            android:maxLines="2"
            android:ellipsize="none"
            tools:text="v4197 | 48000hz | 音量:1.0 | 语速:1.0 | 音高:1.0" />

        <!-- 第三行：插件名(右下) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/tv_plugin_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="11sp"
                android:textColor="@color/secondaryText"
                android:maxLines="1"
                android:ellipsize="none"
                tools:text="百度云端音色池" />
        </LinearLayout>

    </LinearLayout>

    <ImageView
        android:id="@+id/iv_preview"
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:padding="5dp"
        android:src="@drawable/ic_play_24dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="试听"
        app:tint="@color/primaryText" />

    <ImageView
        android:id="@+id/iv_more"
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:padding="5dp"
        android:src="@drawable/ic_more"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="更多"
        app:tint="@color/primaryText" />

    </LinearLayout>

</LinearLayout>
