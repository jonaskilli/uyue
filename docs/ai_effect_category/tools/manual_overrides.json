{
  "_comment": "手工修正音效归属。重跑 export.py 时会自动套用，避免手工改动被覆盖。",
  "_format": {
    "音效名": {
      "set": ["可选，完全覆盖分类列表"],
      "add": ["可选，追加分类"],
      "remove": ["可选，删除分类"]
    }
  },
  "_example": {
    "重拳入肉": { "set": ["A03", "A05"] },
    "大理石皮鞋一步": { "add": ["D03"] },
    "倒车雷达一声": { "remove": ["F02"], "add": ["I03", "K06"] }
  },
  "effects": {}
}
