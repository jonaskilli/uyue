{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "场景特效语义标注输出",
  "description": "大模型只输出语义判断，不输出绘图指令。站内存在 v1（内部规范形式）与 v2（模型输出形式）两种；weatherInterval 定义同时覆盖两者，解析时由 Zde() 把 v2 转成 v1。对应实现见 renderer/effect-resolver.ts。",
  "type": "object",
  "required": ["a", "w"],
  "additionalProperties": false,
  "properties": {
    "v": {
      "description": "标注版本：1 = 内部规范形式（a/w 已规范化），2 = 模型原始输出（w 为 weather 对象）",
      "type": "integer",
      "enum": [1, 2]
    },
    "a": {
      "description": "逐动作语义标注列表",
      "type": "array",
      "items": { "$ref": "#/definitions/actionAnnotation" }
    },
    "w": {
      "description": "天气区间列表。v2 时用 weatherIntervalV2，解析后统一为 weatherIntervalV1",
      "type": "array",
      "items": {
        "oneOf": [
          { "$ref": "#/definitions/weatherIntervalV1" },
          { "$ref": "#/definitions/weatherIntervalV2" }
        ]
      }
    },
    "op": {
      "description": "开场效果（仅第一批允许），id 必须来自 semantic-effects.json",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "cId": { "type": "string" }
      },
      "required": ["id"],
      "additionalProperties": false
    },
    "overrides": {
      "description": "人工覆盖：按 cs:o 覆盖自动生成的 fx，并整体替换 w",
      "type": "object",
      "properties": {
        "a": { "type": "array", "items": { "$ref": "#/definitions/actionEffect" } },
        "w": { "type": "array", "items": { "$ref": "#/definitions/weatherIntervalV1" } }
      }
    }
  },
  "definitions": {
    "actionPoint": {
      "description": "动作定位：[章节号, 动作序号]",
      "type": "array",
      "items": { "type": "integer", "minimum": 1 },
      "minItems": 2,
      "maxItems": 2
    },
    "cue": {
      "type": "object",
      "required": ["kind"],
      "properties": {
        "kind": {
          "type": "string",
          "description": "语义 cue，见 mapping/semantic-cues.json 的 cueToEffectIds 键"
        },
        "intensity": {
          "type": "string",
          "enum": ["mild", "strong", "extreme"]
        },
        "windLevel": { "type": "number", "minimum": 0 },
        "color": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
        "opacity": { "type": "number", "minimum": 0, "maximum": 1 },
        "cId": { "type": "string", "description": "需要指定人物的效果必须给出" }
      }
    },
    "actionAnnotation": {
      "type": "object",
      "required": ["cs", "o"],
      "properties": {
        "cs": { "type": "integer", "minimum": 1, "description": "章节号 chapterSeq" },
        "o": { "type": "integer", "description": "动作序号 order" },
        "cues": { "type": "array", "items": { "$ref": "#/definitions/cue" } },
        "tone": { "type": "string", "enum": ["lighthearted", "serious", "neutral"] },
        "fx": {
          "description": "解析后写入的最终效果 ID 列表（模型不输出）",
          "type": "array",
          "items": { "$ref": "#/definitions/effectRef" }
        }
      }
    },
    "effectRef": {
      "type": "object",
      "required": ["id"],
      "properties": {
        "id": { "type": "string", "description": "稳定效果 ID，必须存在于 presets/semantic-effects.json" },
        "color": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
        "opacity": { "type": "number", "minimum": 0, "maximum": 1 },
        "cId": { "type": "string" },
        "windLevel": { "type": "number" }
      }
    },
    "actionEffect": {
      "type": "object",
      "required": ["cs", "o", "fx"],
      "properties": {
        "cs": { "type": "integer" },
        "o": { "type": "integer" },
        "fx": { "type": "array", "items": { "$ref": "#/definitions/effectRef" } }
      }
    },
    "weatherIntervalV1": {
      "description": "规范化后的天气区间（Zde 输出 / pue 校验后）",
      "type": "object",
      "required": ["s", "e", "t"],
      "properties": {
        "s": { "$ref": "#/definitions/actionPoint" },
        "e": { "$ref": "#/definitions/actionPoint" },
        "t": { "type": "string", "enum": ["r", "s"], "description": "r=rain, s=snow" },
        "lv": { "type": "integer", "minimum": 1, "maximum": 4 },
        "l": { "type": "integer", "enum": [0, 1], "description": "是否有闪电" },
        "w": { "type": "integer", "enum": [0, 1], "description": "是否有风" },
        "indoors": { "type": "integer", "enum": [0, 1], "description": "1=室内，禁止降水粒子" }
      }
    },
    "weatherIntervalV2": {
      "description": "模型原始天气区间（effectAnnotation v2 输出）",
      "type": "object",
      "required": ["s", "e", "weather", "intensity", "indoors"],
      "properties": {
        "s": { "$ref": "#/definitions/actionPoint" },
        "e": { "$ref": "#/definitions/actionPoint" },
        "weather": { "type": "string", "enum": ["rain", "snow"] },
        "intensity": { "type": "string", "enum": ["light", "moderate", "heavy", "violent"] },
        "lightning": { "type": "boolean" },
        "wind": { "type": "boolean" },
        "indoors": { "type": "boolean" }
      }
    }
  }
}
